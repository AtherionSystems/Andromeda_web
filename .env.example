# Copy this file to .env and fill in your values.
# Never commit the real .env file.

VITE_OCI_AUTH_URL=https://idcs-<tenant>.identity.oraclecloud.com/oauth2/v1/authorize
VITE_OCI_TOKEN_URL=https://idcs-<tenant>.identity.oraclecloud.com/oauth2/v1/token
VITE_OCI_LOGOUT_URL=https://idcs-<tenant>.identity.oraclecloud.com/oauth2/v1/userlogout
VITE_OCI_CLIENT_ID=your_client_id_here
# OCI IAM requires https:// — even for localhost. Use Vite's basicSsl plugin in dev.
VITE_OCI_REDIRECT_URI=https://localhost:5173/callback
VITE_OCI_SCOPE=openid http://localhost:8080/read

# Leave empty in dev (Vite proxy handles /api → http://localhost:8080)
# Set to http://<backend-ip>:8080 in production
VITE_API_BASE_URL=
